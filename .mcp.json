{
  "mcpServers": {
    "pvm": {
      "type": "stdio",
      "command": "wsl",
      "args": ["bash", "-lc", "./run_pvm_mcp.sh"],
      "env": {}
    },
    "promptfoo": {
      "type": "stdio",
      "command": "wsl",
      "args": ["bash", "-lc", "npx -y promptfoo@latest mcp --transport stdio"],
      "env": {}
    }
  }
}